{
	"name": "olivetin-webui",
	"version": "1.0.0",
	"description": "The WebUI for OliveTin",
	"repository": "https://github.com/OliveTin/OliveTin",
	"type": "module",
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint": "^10.14.0",
		"eslint-plugin-vue": "^10.12.1",
		"neostandard": "^0.14.1",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"vite": "^8.3.8"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"lint": "eslint main.js js/* resources/vue vite.config.mjs && stylelint \"style.css\" \"themes/**/*.css\"",
		"lint:fix": "eslint --fix main.js js/* resources/vue vite.config.mjs && stylelint --fix \"style.css\" \"themes/**/*.css\"",
		"preview": "vite preview",
		"test": "node --test resources/vue/components/*.test.mjs resources/vue/utils/*.test.mjs resources/vue/stores/*.test.mjs"
	},
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@connectrpc/connect": "^2.3.0",
		"@connectrpc/connect-web": "^2.3.0",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/vue": "^1.0.8",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"iconify-icon": "^3.0.5",
		"picocrank": "^1.41.0",
		"vue": "^3.5.45",
		"vue-i18n": "^11.4.18",
		"vue-router": "^5.5.0"
	},
	"engines": {
		"node": "^22.13.0 || >=24"
	}
}
